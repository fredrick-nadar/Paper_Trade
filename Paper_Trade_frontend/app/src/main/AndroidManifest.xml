<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Paper_Trade_frontend"
        android:name="com.clevertap.android.sdk.Application">

        <!-- CleverTap uses these credentials to identify the project receiving campaigns. -->
        <meta-data
            android:name="CLEVERTAP_ACCOUNT_ID"
            android:value="487-878-Z97Z"/>
        <meta-data
            android:name="CLEVERTAP_TOKEN"
            android:value="bab-ab4"/>

        <meta-data
            android:name="CLEVERTAP_NOTIFICATION_ICON"
            android:value="ic_launcher_foreground"/>

        <!-- Firebase delivers campaign data to MyFcmMessageListenerService below. -->
        <meta-data
            android:name="CLEVERTAP_BACKGROUND_SYNC"
            android:value="1"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.Paper_Trade_frontend"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receives CleverTap's data-only FCM campaigns and renders/tracks them in app code. -->
        <service
            android:name=".MyFcmMessageListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <!-- Receives CleverTap click/deeplink broadcasts for SDK-rendered notifications. -->
        <receiver
            android:name="com.clevertap.android.sdk.pushnotification.CTPushNotificationReceiver"
            android:enabled="true"
            android:exported="false"/>
    </application>

</manifest>