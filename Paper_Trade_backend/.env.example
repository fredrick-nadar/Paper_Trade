# Copy to .env (gitignored) and fill in. Never commit .env.
DB_USER=papertrade
DB_PASSWORD=change-me
# 32+ random characters, e.g. run: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Free key from https://finnhub.io
FINNHUB_KEY=
# Path to the Firebase Admin service-account JSON, kept outside source control.
FIREBASE_SERVICE_ACCOUNT_PATH=../Paper_Trade_frontend/firebase-service-account.json
